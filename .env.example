# AgentRouter API Key (OpenAI-compatible)
AGENTROUTER_API_KEY=your_api_key_here
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1

# Primary model for classification and generation
LLM_MODEL=deepseek-v4-flash

# Judge model (use a stronger model for evaluation)
JUDGE_MODEL=claude-opus-4-8

# Kaggle credentials (optional — only if using kaggle API download)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
